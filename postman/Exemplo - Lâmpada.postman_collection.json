								]
							}
						}
					]
				},
				{
					"name": "3.5 [Pronto] Simula ambiente claro (medida pela porta HTTP)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "http://{{iotahttp}}/iot/json?k={{apikey}}&i={{device_id}}",
							"protocol": "http",
							"host": [
								"{{iotahttp}}"
							],
							"path": [
								"iot",
								"json"
							],
							"query": [
								{
									"key": "k",
									"value": "{{apikey}}"
								},
								{
									"key": "i",
									"value": "{{device_id}}"
								}
							]
						},
						"description": "Envia **uma** medida pela porta HTTP do IoT Agent (7896), como se a lâmpada tivesse medido 95 % de luz. Com a lâmpada acesa (2.1), a condição da 3.3 fica verdadeira.",
						"body": {
							"mode": "raw",
							"raw": "{\n    \"l\": 95\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Medida aceita\", () => pm.expect(pm.response.code).to.be.oneOf([200, 204]));"
								]
							}
						}
					]
				},
				{
					"name": "3.6 [Verificação] O consumidor recebeu o alerta",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://{{consumidor}}/notificacoes?caminho=/alerta-lampada",
							"protocol": "http",
							"host": [
								"{{consumidor}}"
							],
							"path": [
								"notificacoes"
							],
							"query": [
								{
									"key": "caminho",
									"value": "/alerta-lampada"
								}
							]
						},
						"description": "A notificação chega em `keyValues`: `data` traz só os atributos pedidos. A verificação espera 12 s: com o `throttling` de 10 s, o próximo alerta pode demorar até isso."
					},
					"response": [],
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// aguarda a notificação (throttling de 10 s)",
									"setTimeout(() => {}, 12000);"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
									"const n = pm.response.json().filter(x => x.corpo && x.corpo.subscriptionId === pm.collectionVariables.get(\"subAlerta\"));",
									"pm.test(\"Alerta recebido\", () => pm.expect(n.length).to.be.above(0));",
									"pm.test(\"Lâmpada acesa e luz acima de 70 %\", () => pm.expect(n.some(x => x.corpo.data.some(d => d.state === 1 && d.luminosity > 70))).to.be.true);"
								]
							}
						}
					]
				},
